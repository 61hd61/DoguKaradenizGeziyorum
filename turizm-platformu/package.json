{
  "name": "turizm-platformu",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "db:generate": "turbo run db:generate --filter=@turizm/database",
    "db:push": "turbo run db:push --filter=@turizm/database",
    "db:migrate": "turbo run db:migrate --filter=@turizm/database",
    "db:studio": "turbo run db:studio --filter=@turizm/database",
    "db:seed": "turbo run db:seed --filter=@turizm/api",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "@types/node": "^20.12.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.5.0"
}