# Turizm Platformu - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://postgres:1234@localhost:5432/trabzon_turizm?schema=public"

# ============================================
# SERVER
# ============================================
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
API_PREFIX=/api/v1

# ============================================
# JWT
# ============================================
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars-long"
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
JWT_ISSUER=turizm-platformu
JWT_AUDIENCE=turizm-platformu-users

# ============================================
# EMAIL (SMTP)
# ============================================
# For development, use Mailhog (docker-compose): SMTP_HOST=localhost, SMTP_PORT=1025
# For production, use real SMTP (SendGrid, Mailgun, etc.)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@turizm.local
EMAIL_VERIFY_URL=http://localhost:5173/verify-email
EMAIL_RESET_URL=http://localhost:5173/reset-password

# ============================================
# CORS
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ============================================
# EXTERNAL APIs
# ============================================
# LibreTranslate for translations (optional)
LIBRETRANSLATE_URL=http://localhost:5000

# Open-Meteo for weather (free, no key needed)
# WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# ============================================
# FILE UPLOAD
# ============================================
UPLOAD_MAX_SIZE=10485760
UPLOAD_DEST=./uploads

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info

# ============================================
# FRONTEND URL (for email links)
# ============================================
FRONTEND_URL=http://localhost:5173