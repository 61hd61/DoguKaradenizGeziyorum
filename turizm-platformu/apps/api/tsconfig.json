{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@turizm/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": ["src/map-server.ts", "src/lib/**/*.ts"],
  "exclude": ["node_modules", "dist", "prisma"]
}