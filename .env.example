# ============================================================
# GitHub / yerel kurulum — bu dosyayı KOPYALAYIP .env yapın
# Konum: turizm-platformu/.env  (ana dosya)
# ============================================================
# Asagidaki satirlari turizm-platformu/.env icine tasiyin.

DATABASE_URL=postgresql://postgres:1234@localhost:5432/trabzon_turizm?schema=public
USER_DATABASE_URL=postgresql://postgres:1234@localhost:5432/trabzon_turizm_users

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

JWT_SECRET=degistirin-en-az-32-karakter-uzun-gizli-anahtar
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=30

WEB_PUBLIC_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:8081

# Gelistirme: e-posta dogrulamayi atla (uretimde false / silin)
SKIP_EMAIL_VERIFY=true

PII_ENCRYPTION_KEY=degistirin-32-byte-pii-anahtari

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@turizm.local

LIBRETRANSLATE_URL=https://libretranslate.com

# Destinasyon gorselleri (repo kokune gore)
DESTINATION_IMAGES_DIR=../destinasyon/images

LOG_LEVEL=info
